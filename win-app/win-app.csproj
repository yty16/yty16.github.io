<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>元拓域Toolbox</AssemblyName>
    <RootNamespace>YToolboxWinApp</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ProductVersion>2.0.0</ProductVersion>
    <AssemblyTitle>元拓域 Toolbox</AssemblyTitle>
    <Company>yty16</Company>
    <Copyright>yty16</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Web.WebView2 由 dotnet add package 注入 -->
  </ItemGroup>

  <ItemGroup>
    <!-- 整站离线资源，随发布一起分发 -->
    <Content Include="www\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
